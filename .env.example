# 复制成 .env 后按需填写（.env 已被 .gitignore 忽略，不会进 git）
# Windows: copy .env.example .env     Linux/macOS: cp .env.example .env

# 翻译后端：ollama / openai / deepl / gemini
VSUB_PROVIDER=ollama

# 翻译模型
VSUB_MODEL=qwen3:8b

# 服务地址。留空则用该后端默认值
# ollama 默认 http://127.0.0.1:11434（也可以是局域网另一台机器）
# VSUB_BASE_URL=http://127.0.0.1:11434
# VSUB_BASE_URL=https://api.deepseek.com/v1

# API key。建议只放这里，不要写进 config.toml
# VSUB_API_KEY=sk-xxxxxx

# 目标语言
VSUB_TGT=zh
